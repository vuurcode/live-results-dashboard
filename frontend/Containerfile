# Stage 1: Build
FROM node:24 AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# Stage 2: Serve
FROM nginx:alpine-slim

# Runtime settings. BACKEND_URL is the API address the browser uses (empty: the same origin, proxied under /api and /ws);
# BACKEND_UPSTREAM is where nginx reaches the backend (host:port). CSP_CONNECT_SRC lists the origins the page may call (add
# the backend's, e.g. "'self' https://api.example.com wss://api.example.com", when BACKEND_URL points to another host);
# CSP_FRAME_ANCESTORS lists the hosts that may embed the page ('none': nobody).
ENV BACKEND_URL="" \
    BACKEND_UPSTREAM="backend:5000" \
    CSP_CONNECT_SRC="'self'" \
    CSP_FRAME_ANCESTORS="'none'"

COPY --from=build /app/dist/dashboard/browser /usr/share/nginx/html
COPY config/nginx.conf.template /etc/nginx/default.conf.template
COPY config/security-headers.conf /etc/nginx/security-headers.conf.template
COPY public/env-inject.js /usr/share/nginx/html/env-inject.js

EXPOSE 80

CMD ["/bin/sh", "-c", "envsubst '${BACKEND_UPSTREAM}' < /etc/nginx/default.conf.template > /etc/nginx/conf.d/default.conf && envsubst '${CSP_CONNECT_SRC} ${CSP_FRAME_ANCESTORS}' < /etc/nginx/security-headers.conf.template > /etc/nginx/security-headers.conf && envsubst '${BACKEND_URL}' < /usr/share/nginx/html/env-inject.js > /tmp/env-inject.js && mv /tmp/env-inject.js /usr/share/nginx/html/env-inject.js && exec nginx -g 'daemon off;'"]

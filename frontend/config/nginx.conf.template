# Template: BACKEND_UPSTREAM (host:port of the backend) is filled in when the container starts.
server_tokens off;

# text assets compress to about a quarter; the websocket and already compressed images are left alone
gzip on;
gzip_comp_level 6;
gzip_min_length 512;
gzip_vary on;
gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain image/x-icon;

server {
    listen 80;
    root /usr/share/nginx/html;

    # Every location includes the security headers itself: a location with an add_header of its own drops the inherited ones.
    # Files with a hash in their name never change: cache them for good.
    location ~ "^/.+-[A-Z0-9]{8}\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }
    # The page and the runtime settings change with a deploy: always revalidate.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }
    location = /env-inject.js {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }
    # Anything with a file extension that does not exist is a real 404; only page routes fall back to the app.
    location ~* \.[a-z0-9]+$ {
        add_header Cache-Control "public, max-age=86400" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
    location ^~ /api {
        include /etc/nginx/security-headers.conf;
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /ws {
        proxy_pass http://${BACKEND_UPSTREAM}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        # the backend pings every 25 seconds; an idle socket is not dropped before that matters
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}

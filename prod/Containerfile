# One container for hosting: nginx serves the frontend and proxies /api and /ws (plus /healthcheck) to the backend,
# which listens on loopback only. s6-overlay starts both and stops the container when either one dies.
# Build from the repository root:  docker build -f prod/Containerfile .

# Frontend build
FROM node:26 AS frontend
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# Backend build: image pinned by digest; modules pinned in go.mod and verified against go.sum
FROM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS backend
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly GOTOOLCHAIN=local
COPY backend/src/go.mod backend/src/go.sum ./
RUN go mod download && go mod verify
COPY backend/src/ ./
RUN go build -trimpath -ldflags="-s -w" -o /backend ./cmd/server

# s6-overlay release archives, verified against the published checksums (one stage per architecture)
FROM scratch AS s6-amd64
ADD --checksum=sha256:5379750ed30a84bbd2e2dd74847ba6b5bd29cd0b2e3ea2ec58049b57eb2eda12 https://github.com/just-containers/s6-overlay/releases/download/v3.2.3.2/s6-overlay-noarch.tar.xz /noarch.tar.xz
ADD --checksum=sha256:e6befcc96a437a3831386ecfc51808c5d3e939dc5fe3c02ae9284599e8aa2408 https://github.com/just-containers/s6-overlay/releases/download/v3.2.3.2/s6-overlay-x86_64.tar.xz /arch.tar.xz

FROM scratch AS s6-arm64
ADD --checksum=sha256:5379750ed30a84bbd2e2dd74847ba6b5bd29cd0b2e3ea2ec58049b57eb2eda12 https://github.com/just-containers/s6-overlay/releases/download/v3.2.3.2/s6-overlay-noarch.tar.xz /noarch.tar.xz
ADD --checksum=sha256:b17f17a82e7a515c682a91edaf2ffdabb73f891981b6c1fd712115693a2f8b4c https://github.com/just-containers/s6-overlay/releases/download/v3.2.3.2/s6-overlay-aarch64.tar.xz /arch.tar.xz

ARG TARGETARCH
FROM s6-${TARGETARCH} AS s6

FROM nginx:alpine-slim

# Runtime settings. LISTEN_PORT is the port nginx listens on (DigitalOcean App Platform expects 8080). BACKEND_URL is the
# API address the browser uses (empty: the same origin). CSP_CONNECT_SRC lists the origins the page may call;
# CSP_FRAME_ANCESTORS the hosts that may embed it ('none': nobody). The backend's own settings are passed through as is.
ENV LISTEN_PORT="8080" \
    BACKEND_UPSTREAM="127.0.0.1:5000" \
    BACKEND_URL="" \
    CSP_CONNECT_SRC="'self'" \
    CSP_FRAME_ANCESTORS="'none'" \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=2

RUN --mount=type=bind,from=s6,target=/s6 tar -C / -Jxpf /s6/noarch.tar.xz && tar -C / -Jxpf /s6/arch.tar.xz

COPY --from=backend /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=backend /backend /usr/local/bin/backend
COPY --from=frontend /app/dist/dashboard/browser /usr/share/nginx/html
COPY frontend/config/nginx.conf.template /etc/nginx/default.conf.template
COPY frontend/config/security-headers.conf /etc/nginx/security-headers.conf.template
COPY frontend/public/env-inject.js /etc/nginx/env-inject.js.template
COPY prod/rootfs/ /

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD wget -q -O /dev/null "http://127.0.0.1:${LISTEN_PORT}/healthcheck" || exit 1
ENTRYPOINT ["/init"]

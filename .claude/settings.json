{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ruff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(/tunnel/**)",
      "Edit(/tunnel/**)",
      "Bash(*tunnel/*)",
      "Read(/container-data/**)",
      "Edit(/container-data/**)",
      "Bash(*container-data/*)",
      "Read(/mockserver/data/**)",
      "Edit(/mockserver/data/**)",
      "Bash(*mockserver/data/*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Bash(*.env*)"
    ]
  },
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": false,
  "respectGitignore": true,
  "showTurnDuration": true,
  "statusLine": {
    "type": "command",
    "command": "/app/.claude/statusline.sh"
  }
}
